<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Branca Jalecos</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2=family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  {{> _navbar}}
  

  {{{body}}}

{{#if user}}
<div class="logout-overlay" id="overlay" hidden></div>


<div class="logout-confirm-box" id="logoutConfirm" role="dialog" aria-modal="true" aria-labelledby="logoutConfirmTitle" aria-describedby="logoutConfirmDescription" hidden>

    <h4 id="logoutConfirmTitle">Sair da conta?</h4>

    <p id="logoutConfirmDescription">
        Você será desconectado da sua sessão.
    </p>


    <div class="logout-buttons">

        <button id="cancelLogout" class="logout-btn-cancel" type="button">
            Cancelar
        </button>


        <form action="/users/logout" method="GET">

            <button class="logout-btn-confirm" type="submit">
                Sair
            </button>

        </form>

    </div>

</div>


{{/if}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  
  <script src="/js/main.js"></script>

  <script src="/js/logoutConfirm.js"></script>
</body>
</html>
