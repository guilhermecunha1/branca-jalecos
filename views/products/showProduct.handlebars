<div class="container py-4 py-lg-5">
  
  <!-- Navegação / Breadcrumb -->
  <nav class="mb-4">
    <a href="/products" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center hover-orange transition-all">
      <i class="bi bi-arrow-left me-2"></i> Voltar para as Coleções
    </a>
  </nav>

  <div class="row g-4 g-lg-5 align-items-start">
    
    <!-- COLUNA DA ESQUERDA: Fotos / Placeholders -->
    <div class="col-lg-6">
      <div class="product-gallery-wrapper">
        
        <!-- Imagem Principal (Proporção 3:4) -->
        <div class="main-product-img-placeholder position-relative d-flex align-items-center justify-content-center mb-3 border bg-white">
          
          <!-- Badges sobre a foto -->
          <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2" style="z-index: 2;">
            <span class="badge text-uppercase fw-semibold gender-badge-pdp">
              {{product.gender}}
            </span>
            {{#unless product.active}}
              <span class="badge bg-dark text-white text-uppercase fw-semibold px-3 py-2" style="letter-spacing: 1.5px; font-size: 0.65rem;">
                Indisponível
              </span>
            {{/unless}}
          </div>

          <!-- Destaque de Foto Em Breve -->
          <div class="text-center p-4">
            <i class="bi bi-bag-dash display-4 d-block mb-2 text-secondary opacity-50"></i>
            <span class="small text-uppercase fw-bold text-secondary d-block" style="letter-spacing: 1.5px; font-size: 0.75rem;">
              Fotografia do Produto
            </span>
            <span class="text-muted small fw-light">Em breve galeria em alta resolução</span>
          </div>

        </div>

        <!-- Miniaturas Placeholder (Para quando tiver mais fotos) -->
        <div class="row g-2">
          <div class="col-3">
            <div class="thumb-placeholder border bg-white d-flex align-items-center justify-content-center active-thumb">
              <i class="bi bi-image text-muted opacity-50"></i>
            </div>
          </div>
          <div class="col-3">
            <div class="thumb-placeholder border bg-white d-flex align-items-center justify-content-center">
              <i class="bi bi-image text-muted opacity-50"></i>
            </div>
          </div>
          <div class="col-3">
            <div class="thumb-placeholder border bg-white d-flex align-items-center justify-content-center">
              <i class="bi bi-image text-muted opacity-50"></i>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- COLUNA DA DIREITA: Informações e Formulário de Compra -->
    <div class="col-lg-6">
      <div class="ps-lg-3">
        
        <!-- Título e Código -->
        <p class="text-uppercase small fw-bold m-0 mb-1" style="color: #f18e3f; letter-spacing: 2px;">Branca Jalecos</p>
        <h1 class="fw-light text-dark mb-2 display-6">{{product.name}}</h1>
        <p class="table-product-slug mb-3">REF: {{product.slug}}</p>

        <!-- Preço -->
        <div class="d-flex align-items-baseline gap-2 mb-4 pb-3 border-bottom" style="border-color: #eadecc !important;">
          <span class="fs-2 fw-bold text-dark">R$ {{product.basePrice}}</span>
          <span class="text-secondary small">em até 6x sem juros</span>
        </div>

        <!-- Descrição Completa -->
        <div class="mb-4">
          <h2 class="h6 text-uppercase fw-semibold text-secondary mb-2" style="letter-spacing: 1px;">Descrição do Modelo</h2>
          <p class="text-secondary leading-relaxed" style="font-size: 0.95rem; line-height: 1.7;">
            {{product.description}}
          </p>
        </div>

        <!-- FORMULÁRIO DE COMPRA / ADICIONAR AO CARRINHO -->
        <form action="/cart/add" method="POST">
          <input type="hidden" name="productId" value="{{product._id}}">

          <!-- Seleção de Cores -->
          {{#if product.colors.length}}
          <div class="mb-4">
            <label class="form-label text-uppercase small fw-semibold text-secondary d-block mb-2" style="letter-spacing: 1px;">
              Cor Selecionada
            </label>
            <div class="d-flex flex-wrap gap-2">
              {{#each product.colors}}
                <input type="radio" class="btn-check" name="color" id="color-{{this}}" value="{{this}}" required>
                <label class="btn btn-option-pill px-3 py-2" for="color-{{this}}">{{this}}</label>
              {{/each}}
            </div>
          </div>
          {{/if}}

          <!-- Seleção de Tamanhos -->
          {{#if product.sizes.length}}
          <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <label class="form-label text-uppercase small fw-semibold text-secondary m-0" style="letter-spacing: 1px;">
                Tamanho
              </label>
              <!-- Link auxiliar opcional -->
              <a href="#tabela-tamanhos" class="text-decoration-none text-secondary small" style="font-size: 0.8rem;" data-bs-toggle="modal" data-bs-target="#modalGuiaTamanhos">
                <i class="bi bi-ruler me-1"></i> Guia de Medidas
              </a>
            </div>
            
            <div class="d-flex flex-wrap gap-2">
              {{#each product.sizes}}
                <input type="radio" class="btn-check" name="size" id="size-{{this}}" value="{{this}}" required>
                <label class="btn btn-option-tile" for="size-{{this}}">{{this}}</label>
              {{/each}}
            </div>
          </div>
          {{/if}}

          <!-- Quantidade e Botão de Ação -->
          <div class="row g-3 align-items-end pt-3 border-top" style="border-color: #eadecc !important;">
            
            <div class="col-4 col-sm-3">
              <label for="quantity" class="form-label text-uppercase small fw-semibold text-secondary mb-2" style="letter-spacing: 1px;">Qtd.</label>
              <input type="number" class="form-control text-center rounded-0 focus-premium py-2 fw-bold" id="quantity" name="quantity" value="1" min="1" max="10" required>
            </div>

            <div class="col-8 col-sm-9">
              {{#if product.active}}
                <button type="submit" class="btn btn-premium w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                  <i class="bi bi-bag-plus fs-5"></i>
                  <span>ADICIONAR AO CARRINHO</span>
                </button>
              {{else}}
                <button type="button" class="btn btn-secondary w-100 py-3 text-uppercase fw-semibold disabled" disabled>
                  PRODUTO INDISPONÍVEL
                </button>
              {{/if}}
            </div>

          </div>

        </form>

        <!-- Garantias e Vantagens (Estilo Editorial) -->
        <div class="mt-5 pt-4 border-top d-flex flex-column gap-3" style="border-color: #f0f0f0 !important;">
          <div class="d-flex align-items-center gap-3">
            <i class="bi bi-truck fs-4 text-dark"></i>
            <div>
              <p class="mb-0 fw-semibold text-dark small">Envio Para Todo o Brasil</p>
              <p class="mb-0 text-secondary extra-small" style="font-size: 0.78rem;">Entregas com rastreamento e embalagem especial.</p>
            </div>
          </div>
          <div class="d-flex align-items-center gap-3">
            <i class="bi bi-arrow-counterclockwise fs-4 text-dark"></i>
            <div>
              <p class="mb-0 fw-semibold text-dark small">Troca Fácil em até 30 Dias</p>
              <p class="mb-0 text-secondary extra-small" style="font-size: 0.78rem;">Primeira troca grátis para garantir o ajuste perfeito.</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<!-- Estilos específicos da página de detalhes do produto -->
<style>
  /* Imagem Principal 3:4 */
  .main-product-img-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f8f6f2;
    border-color: #eadecc !important;
  }

  .gender-badge-pdp {
    background-color: rgba(255, 255, 255, 0.95);
    color: #2c2c2c;
    border: 1px solid #eadecc;
    font-size: 0.7rem;
    letter-spacing: 1.5px;
    padding: 6px 12px;
  }

  /* Miniaturas de foto */
  .thumb-placeholder {
    aspect-ratio: 1 / 1;
    cursor: pointer;
    border-color: #eadecc !important;
    transition: all 0.2s ease;
  }
  .thumb-placeholder:hover, 
  .thumb-placeholder.active-thumb {
    border-color: #f18e3f !important;
  }

  /* Botoes de Selecao de Cor (Pills) */
  .btn-option-pill {
    background-color: #ffffff;
    border: 1px solid #eadecc;
    color: #4a4a4a;
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: 50px;
    transition: all 0.2s ease;
  }
  .btn-check:checked + .btn-option-pill {
    background-color: #1a1a1a;
    border-color: #1a1a1a;
    color: #ffffff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }

  /* Botoes de Selecao de Tamanho (Tiles Quadrados) */
  .btn-option-tile {
    min-width: 48px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border: 1px solid #eadecc;
    color: #2c2c2c;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 2px;
    transition: all 0.2s ease;
  }
  .btn-check:checked + .btn-option-tile {
    background-color: #f18e3f;
    border-color: #f18e3f;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(241, 142, 63, 0.25);
  }

  .btn-option-pill:hover, 
  .btn-option-tile:hover {
    border-color: #f18e3f;
  }

  /* Hover suave no link de voltar */
  .hover-orange:hover {
    color: #f18e3f !important;
  }
</style>