<div class="container py-5">
  
  <!-- Cabeçalho da Vitrine -->
  <div class="text-center mb-5">
    <p class="text-uppercase small fw-semibold m-0" style="color: #f18e3f; letter-spacing: 2.5px;">Coleção Exclusiva</p>
    <h1 class="fw-light text-dark m-0 display-5" style="letter-spacing: -0.5px;">Jalecos & Workwear</h1>
    <p class="text-secondary mt-2 mx-auto" style="max-width: 500px; font-size: 0.95rem;">
      Descubra a fusão perfeita entre alta costura, conforto e durabilidade para a sua rotina profissional.
    </p>
  </div>

  {{> _errors}}
  {{> _flashMsg}}

  <!-- Grid de Produtos -->
  <div class="row g-4">
    {{#each products}}
      <div class="col-12 col-sm-6 col-md-4 col-lg-3">
        
        <!-- Card do Produto (Aplica classe disabled quando active for false) -->
        <div class="product-card h-100 border bg-white d-flex flex-column {{#unless this.active}}product-disabled{{/unless}}">
          
          <!-- Placeholder de Imagem (Proporção Moda 3:4) -->
          <div class="product-img-placeholder position-relative d-flex align-items-center justify-content-center">
            
            <!-- Badge de Indisponível (Se estiver desativado) -->
            {{#unless this.active}}
              <span class="badge bg-dark text-white position-absolute top-0 start-0 m-3 px-3 py-2 text-uppercase fw-semibold" style="letter-spacing: 1.5px; font-size: 0.65rem; z-index: 2;">
                Indisponível
              </span>
            {{/unless}}

            <!-- Tag de Gênero -->
            <span class="badge position-absolute top-0 end-0 m-3 text-uppercase fw-semibold gender-badge">
              {{this.gender}}
            </span>

            <!-- Área da Foto (Em Breve) -->
            <div class="text-center opacity-40">
              <i class="bi bi-bag-dash fs-2 d-block mb-1 text-secondary"></i>
              <span class="small text-uppercase fw-bold text-secondary" style="letter-spacing: 1px; font-size: 0.65rem;">
                Foto Em Breve
              </span>
            </div>
            
          </div>

          <!-- Informações do Jaleco -->
          <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
            <div>
              <h3 class="h6 fw-bold text-dark mb-1 text-truncate" title="{{this.name}}">{{this.name}}</h3>
              
              <p class="text-secondary small mb-3 description-clamp">
                {{this.description}}
              </p>
            </div>

            <div>
              <!-- Preço -->
              <div class="d-flex align-items-baseline justify-content-between mb-3 pt-2 border-top" style="border-color: #f5f5f5 !important;">
                <span class="text-uppercase text-muted" style="font-size: 0.7rem; letter-spacing: 0.5px;">A partir de</span>
                <span class="fw-bold fs-5 text-dark">R$ {{this.basePrice}}</span>
              </div>

              <!-- Botão de Ação -->
              {{#if this.active}}
                <a href="/products/item/{{this.slug}}" class="btn btn-premium w-100 py-2">VER DETALHES</a>
              {{else}}
                <button class="btn btn-secondary w-100 py-2 text-uppercase fw-semibold disabled" style="font-size: 0.75rem; letter-spacing: 1px;" disabled>
                  INDISPONÍVEL
                </button>
              {{/if}}
            </div>
          </div>

        </div>
      </div>
    {{else}}
      <!-- Estado Vazio (Caso não haja nenhum produto cadastrado) -->
      <div class="col-12 text-center py-5">
        <div class="py-5">
          <i class="bi bi-bag-x display-3 text-muted d-block mb-3"></i>
          <h4 class="fw-light text-dark">Nenhum jaleco disponível no momento.</h4>
          <p class="text-secondary">Nossa nova coleção está sendo preparada. Volte em breve!</p>
        </div>
      </div>
    {{/each}}
  </div>

</div>

<!-- Estilos Específicos para a Vitrine de Produtos -->
<style>
  /* Estrutura do Card */
  .product-card {
    border-color: #eadecc !important;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card:not(.product-disabled):hover {
    transform: translateY(-6px);
    border-color: #f18e3f !important;
    box-shadow: 0 15px 35px rgba(241, 142, 63, 0.08);
  }

  /* Placeholder de Foto (Proporção 3:4) */
  .product-img-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f8f6f2;
    border-bottom: 1px solid #eadecc;
    overflow: hidden;
  }

  /* Tag de Gênero Minimalista */
  .gender-badge {
    background-color: rgba(255, 255, 255, 0.92);
    color: #4a4a4a;
    border: 1px solid #eadecc;
    font-size: 0.65rem;
    letter-spacing: 1px;
    backdrop-filter: blur(4px);
  }

  /* Trava da Descrição em 2 linhas max */
  .description-clamp {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.825rem;
    min-height: 2.5rem;
    line-height: 1.25;
  }

  /* Estilização para Produtos Desativados */
  .product-disabled {
    opacity: 0.65;
    background-color: #fafafa !important;
    border-color: #eee !important;
  }

  .product-disabled .product-img-placeholder {
    background-color: #ecebe8;
    filter: grayscale(100%);
  }

  .product-disabled h3, 
  .product-disabled .fs-5 {
    color: #777777 !important;
  }
</style>