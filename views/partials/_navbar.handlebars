<!-- Wrapper Fixador -->
<div class="navbar-floating-wrapper">
  <nav class="navbar navbar-expand-lg navbar-floating mx-auto">
    <div class="container-fluid p-0">
      
      <!-- Brand / Logo -->
      <a class="navbar-brand d-flex align-items-center text-decoration-none me-4 ps-2" href="/">
        <span class="brand-branca">BRANCA</span>
        <span class="brand-jalecos ms-2">JALECOS</span>
      </a>
      
      <!-- Toggler Mobile -->
      <button class="navbar-toggler border-0 shadow-none px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarBranca">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <!-- Menu e Ações -->
      <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarBranca">
        
        <!-- Links Centrais com Fundo Arredondado (Segmented Control) -->
        <ul class="navbar-nav mx-auto mb-3 mb-lg-0 align-items-lg-center nav-menu-pill">
          <li class="nav-item">
            <a class="nav-link nav-link-editorial {{activePage currentPage 'home'}}" href="/">Início</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-editorial {{activePage currentPage 'collection'}}" href="/produtos">Coleções</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-editorial {{activePage currentPage 'about'}}" href="/sobre">Nossa História</a>
          </li>
          {{#if isAdmin}}
          <li class="nav-item">
            <a class="nav-link nav-link-editorial {{activePage currentPage 'admin'}}" href="/admin">Admin</a>
          </li>
          {{/if}}
        </ul>

        <!-- Botões de Ação Padronizados em Altura -->
        {{#if user}}
          <div class="d-flex align-items-center justify-content-lg-end pt-2 pt-lg-0">
            <a href="/users/logout" class="btn btn-nav-outline w-100 w-lg-auto text-center">DESCONECTAR</a>
          </div>
        {{else}}
          <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 gap-lg-3 pt-2 pt-lg-0">
            <a href="/users/login" class="btn btn-nav-outline w-100 w-lg-auto text-center">
              <i class="bi bi-lock me-1" style="font-size: 1rem;"></i> Entrar
            </a>
            <a href="/users/register" class="btn btn-nav-solid w-100 w-lg-auto text-center">
              Criar Conta <i class="bi bi-arrow-right ms-1" style="font-size: 1rem;"></i>
            </a>
          </div>
        {{/if}}

      </div>  
    </div>
  </nav>
</div>

<!-- Spacer para compensar a navbar flutuante -->
<div class="navbar-spacer"></div>