{{#if erros}}
<div class="form-errors animate-fade-in-up" role="alert" aria-live="assertive" style="animation-delay: 0.1s;">
  <div class="form-errors__icon" aria-hidden="true">!</div>
  <div>
    <span class="error-title">Ajustes necessários:</span>
    <ul class="error-list">
      {{#each erros}}
        <li>{{texto}}</li>
      {{/each}}
    </ul>
  </div>
</div>
{{/if}}
