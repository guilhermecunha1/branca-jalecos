{{#if flash}}
<div class="flash-message-container" data-flash-message role="alert" aria-live="assertive">
  <div id="flash-msg" class="flash-message {{flash.type}}">
    <span class="flash-message__icon" aria-hidden="true">!</span>
    <p class="flash-message__text">{{flash.msg}}</p>
    <button class="flash-message__close" type="button" aria-label="Fechar mensagem" data-dismiss-flash>&times;</button>
  </div>
</div>
{{/if}}
